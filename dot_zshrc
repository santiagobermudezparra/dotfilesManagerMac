# DotfilesManagerMac Shell Configuration
# Consolidated from personal dotfiles with Mac/corporate context

# ~~~~~~~~~~~~~~~ Editors ~~~~~~~~~~~~~~~~~~~~~~~~

if command -v nvim >/dev/null 2>&1; then
  export EDITOR="nvim"
  export VISUAL="nvim"
  alias v=nvim
fi

# ~~~~~~~~~~~~~~~ Directories ~~~~~~~~~~~~~~~~~~~~~~~~

export DOTFILES="$HOME/.local/share/chezmoi"

# ~~~~~~~~~~~~~~~ Shell Aliases ~~~~~~~~~~~~~~~~~~~~~~~~

# General shortcuts
alias c=clear

# ls improvements (requires lsd: brew install lsd)
if command -v lsd >/dev/null 2>&1; then
  alias ls=lsd
  alias ll="lsd -lgh"
  alias la="lsd -lathr"
  alias lla="lsd -lgha"
  alias lt="lsd --tree"
fi

# cat improvements (requires bat: brew install bat)
if command -v bat >/dev/null 2>&1; then
  alias cat=bat
fi

# ~~~~~~~~~~~~~~~ History ~~~~~~~~~~~~~~~~~~~~~~~~

HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000

setopt HIST_IGNORE_SPACE  # Don't save when prefixed with space
setopt HIST_IGNORE_DUPS   # Don't save duplicate lines
setopt SHARE_HISTORY      # Share history between sessions

# ~~~~~~~~~~~~~~~ Prompt ~~~~~~~~~~~~~~~~~~~~~~~~

# Pure — minimal async prompt, no wizard, works everywhere
# Docs: https://github.com/sindresorhus/pure

# Don't auto-pull git remotes (keeps prompt snappy)
PURE_GIT_PULL=0

# Async git status (non-blocking)
PURE_ASYNC_WORK_IN_PROGRESS=1

# Use a clean ❯ symbol in a muted colour instead of the default magenta
zstyle ':prompt:pure:prompt:success' color '#8ec07c'  # green on success
zstyle ':prompt:pure:prompt:error'   color '#fb4934'  # red on error
zstyle ':prompt:pure:git:branch'     color '#d79921'  # yellow branch name
zstyle ':prompt:pure:path'           color '#83a598'  # blue path
zstyle ':prompt:pure:git:dirty'      color '#d65d0e'  # orange when dirty

if command -v brew >/dev/null 2>&1; then
  fpath+=("$(brew --prefix)/share/zsh/site-functions")
fi

autoload -U promptinit; promptinit
prompt pure

# ~~~~~~~~~~~~~~~ Vi Mode ~~~~~~~~~~~~~~~~~~~~~~~~

bindkey -v
export KEYTIMEOUT=1

# ~~~~~~~~~~~~~~~ PATH Configuration ~~~~~~~~~~~~~~~~~~~~~~~~

# Add ~/.local/bin and bin/ to PATH for scripts and binaries
path=(
    $path
    $HOME/.local/bin
    $DOTFILES/bin
)

# Remove duplicates and non-existent directories
typeset -U path
path=($^path(N-/))

export PATH
